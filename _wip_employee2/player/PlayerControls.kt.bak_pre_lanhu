/** 细白进度 + 小白圆拇指（非 Material 厚轨、非红）。 */
@OptIn(androidx.compose.material3.ExperimentalMaterial3Api::class)
@Composable
private fun ThinSeekSlider(
    progress: Float,
    onSeekFraction: (Float) -> Unit,
    modifier: Modifier = Modifier,
) {
    val value = progress.coerceIn(0f, 1f)
    Slider(
        value = value,
        onValueChange = { onSeekFraction(it.coerceIn(0f, 1f)) },
        modifier = modifier.height(20.dp),
        colors = SliderDefaults.colors(
            thumbColor = Color.White,
            activeTrackColor = Color.White,
            inactiveTrackColor = Color(0x55FFFFFF),
        ),
        thumb = {
            Box(
                Modifier
                    .size(8.dp)
                    .background(Color.White, CircleShape),
            )
        },
        track = { sliderState ->
            val range = sliderState.valueRange
            val span = (range.endInclusive - range.start).takeIf { it > 0f } ?: 1f
            val frac = ((sliderState.value - range.start) / span).coerceIn(0f, 1f)
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(20.dp),
                contentAlignment = Alignment.CenterStart,
            ) {
                Box(
                    Modifier
                        .fillMaxWidth()
                        .height(2.dp)
                        .clip(RoundedCornerShape(1.dp))
                        .background(Color(0x55FFFFFF))
                        .align(Alignment.Center),
                )
                Box(
                    Modifier
                        .fillMaxWidth(frac)
                        .height(2.dp)
                        .clip(RoundedCornerShape(1.dp))
                        .background(Color.White)
                        .align(Alignment.CenterStart),
                )
            }
        },
    )
}

fun formatPlayerTime(ms: Long): String = formatTime(ms)

private fun formatTime(ms: Long): String {
    val totalSec = TimeUnit.MILLISECONDS.toSeconds(ms.coerceAtLeast(0L))
    val h = totalSec / 3600
    val m = (totalSec % 3600) / 60
    val s = totalSec % 60
    return if (h > 0) {
        String.format(Locale.US, "%d:%02d:%02d", h, m, s)
    } else {
        String.format(Locale.US, "%02d:%02d", m, s)
    }
}
