@Composable
private fun PortraitProgressRow(
    state: PlayerControlsState,
    onSeek: (Long) -> Unit,
    onTogglePlay: () -> Unit,
    onFullscreen: () -> Unit,
) {
    val duration = state.durationMs.coerceAtLeast(0L)
    val position = state.positionMs.coerceIn(0L, duration.coerceAtLeast(1L))
    val progress = if (duration > 0) position.toFloat() / duration.toFloat() else 0f

    Row(
        verticalAlignment = Alignment.CenterVertically,
        modifier = Modifier.fillMaxWidth(),
    ) {
        MiniPlayPause(isPlaying = state.isPlaying, onClick = onTogglePlay)
        // design §B: 时码竖 10sp；widthIn 不裁（禁死宽 48）
        Text(
            formatTime(position),
            color = Color.White,
            fontSize = 10.sp,
            maxLines = 1,
            softWrap = false,
            modifier = Modifier.widthIn(min = 36.dp),
        )
        ThinSeekSlider(
            progress = progress,
            onSeekFraction = { frac ->
                if (duration > 0) onSeek((frac * duration).toLong())
            },
            modifier = Modifier
                .weight(1f)
                .padding(horizontal = 4.dp),
        )
        Text(
            formatTime(duration),
            color = Color.White,
            fontSize = 10.sp,
            maxLines = 1,
            softWrap = false,
            modifier = Modifier.widthIn(min = 36.dp),
        )
        CompactIconButton(onClick = onFullscreen, contentDescription = "Fullscreen") {
            Icon(
                Icons.Default.Fullscreen,
                contentDescription = "Fullscreen",
                tint = Color.White,
                modifier = Modifier.size(20.dp),
            )
        }
    }
}

