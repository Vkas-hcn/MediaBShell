data class PlayerControlsState(
    val title: String = "",
    val isPlaying: Boolean = false,
    val positionMs: Long = 0L,
    val durationMs: Long = 0L,
    val bufferedMs: Long = 0L,
    val subtitleOn: Boolean = false,
    val locked: Boolean = false,
    val autoLabel: String = "AUTO",
    val subtitleText: String? = null,
)

/**
 * Shared player chrome: tap surface toggles visibility; idle auto-hides.
 * Brand red ONLY on the center play/pause primary button.
 * V6 §1 icons + §7 compact sizes.
 */
@Composable
fun PlayerControlsHost(
    landscape: Boolean,
    state: PlayerControlsState,
    onBack: () -> Unit,
    onTogglePlay: () -> Unit,
    onSeekBack15: () -> Unit,
    onSeekForward15: () -> Unit,
    onSeek: (Long) -> Unit,
    onToggleCc: () -> Unit = {},
    onAuto: () -> Unit = {},
    onFullscreen: () -> Unit = {},
    onExitFullscreen: () -> Unit = {},
    onToggleLock: () -> Unit = {},
    idleHideMs: Long = 3200L,
    modifier: Modifier = Modifier,
) {
    var controlsVisible by remember { mutableStateOf(true) }
    var hideToken by remember { mutableLongStateOf(0L) }

    fun bumpVisible() {
        controlsVisible = true
        hideToken++
    }

    LaunchedEffect(hideToken, state.isPlaying, state.locked) {
        if (!controlsVisible) return@LaunchedEffect
        if (state.locked) return@LaunchedEffect
        delay(idleHideMs)
        if (state.isPlaying) {
            controlsVisible = false
        }
    }

    Box(
        modifier = modifier
            .fillMaxSize()
            .clickable(
                indication = null,
                interactionSource = remember { MutableInteractionSource() },
            ) {
                if (state.locked) {
                    controlsVisible = !controlsVisible
                    hideToken++
                } else {
                    controlsVisible = !controlsVisible
                    if (controlsVisible) hideToken++
                }
            },
    ) {
        val sub = state.subtitleText
        if (!sub.isNullOrBlank()) {
            Box(
                modifier = Modifier
                    .align(Alignment.BottomCenter)
                    .padding(bottom = if (landscape) 72.dp else 56.dp)
                    .clip(RoundedCornerShape(4.dp))
                    .background(Color(0x99000000))
                    .padding(horizontal = 12.dp, vertical = 6.dp),
            ) {
                Text(text = sub, color = Color.White, fontSize = 14.sp)
            }
        }

        AnimatedVisibility(
            visible = controlsVisible,
            enter = fadeIn(),
            exit = fadeOut(),
            modifier = Modifier.fillMaxSize(),
        ) {
            if (landscape) {
                LandscapeControls(
                    state = state,
                    onBack = onBack,
                    onTogglePlay = { bumpVisible(); onTogglePlay() },
                    onSeekBack15 = { bumpVisible(); onSeekBack15() },
                    onSeekForward15 = { bumpVisible(); onSeekForward15() },
                    onSeek = { bumpVisible(); onSeek(it) },
                    onToggleCc = { bumpVisible(); onToggleCc() },
                    onAuto = { bumpVisible(); onAuto() },
                    onExitFullscreen = onExitFullscreen,
                    onToggleLock = { bumpVisible(); onToggleLock() },
                )
            } else {
                PortraitControls(
                    state = state,
                    onBack = onBack,
                    onTogglePlay = { bumpVisible(); onTogglePlay() },
                    onSeekBack15 = { bumpVisible(); onSeekBack15() },
                    onSeekForward15 = { bumpVisible(); onSeekForward15() },
                    onSeek = { bumpVisible(); onSeek(it) },
                    onToggleCc = { bumpVisible(); onToggleCc() },
                    onAuto = { bumpVisible(); onAuto() },
                    onFullscreen = onFullscreen,
                )
            }
        }

        if (state.locked && controlsVisible) {
            IconButton(
                onClick = { bumpVisible(); onToggleLock() },
                modifier = Modifier
                    .align(Alignment.CenterEnd)
                    .padding(end = 12.dp)
                    .size(36.dp)
                    .background(Color(0x66000000), CircleShape),
            ) {
                Icon(
                    Icons.Default.Lock,
                    contentDescription = "Unlock",
                    tint = Color.White,
                    modifier = Modifier.size(18.dp),
                )
            }
        }
    }
}

@Composable
private fun CompactIconButton(
    onClick: () -> Unit,
    contentDescription: String,
    modifier: Modifier = Modifier,
    content: @Composable () -> Unit,
) {
    IconButton(
        onClick = onClick,
        modifier = modifier.size(36.dp),
    ) {
        content()
    }
}

@Composable
private fun CcButton(subtitleOn: Boolean, onClick: () -> Unit) {
    CompactIconButton(onClick = onClick, contentDescription = "CC") {
        Icon(
            painter = painterResource(R.drawable.ic_cc_outline),
            contentDescription = "CC",
            tint = if (subtitleOn) Color.White else Color(0xFFB3B3B3),
            modifier = Modifier.size(width = 22.dp, height = 16.dp),
        )
    }
}

@Composable
private fun PortraitControls(
    state: PlayerControlsState,
    onBack: () -> Unit,
    onTogglePlay: () -> Unit,
    onSeekBack15: () -> Unit,
    onSeekForward15: () -> Unit,
    onSeek: (Long) -> Unit,
    onToggleCc: () -> Unit,
    onAuto: () -> Unit,
    onFullscreen: () -> Unit,
) {
    Box(Modifier.fillMaxSize()) {
        Box(
            Modifier
                .fillMaxSize()
                .background(
                    Brush.verticalGradient(
                        listOf(Color(0x88000000), Color.Transparent, Color(0xAA000000)),
                    ),
                ),
        )

        Row(
            Modifier
                .fillMaxWidth()
                .align(Alignment.TopCenter)
                .padding(horizontal = 2.dp, vertical = 2.dp),
            verticalAlignment = Alignment.CenterVertically,
        ) {
            CompactIconButton(onClick = onBack, contentDescription = "Back") {
                Icon(
                    Icons.AutoMirrored.Filled.ArrowBack,
                    contentDescription = "Back",
                    tint = Color.White,
                    modifier = Modifier.size(20.dp),
                )
            }
            Spacer(Modifier.weight(1f))
            AutoChip(label = state.autoLabel, onClick = onAuto)
            CcButton(subtitleOn = state.subtitleOn, onClick = onToggleCc)
        }

        Row(
            Modifier.align(Alignment.Center),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.spacedBy(18.dp), // design §B: 16–20dp
        ) {
            Seek15Button(forward = false, onClick = onSeekBack15)
            PrimaryPlayPause(isPlaying = state.isPlaying, onClick = onTogglePlay)
            Seek15Button(forward = true, onClick = onSeekForward15)
        }

        Column(
            Modifier
                .fillMaxWidth()
                .align(Alignment.BottomCenter)
                .padding(horizontal = 8.dp, vertical = 6.dp),
        ) {
            PortraitProgressRow(
                state = state,
                onSeek = onSeek,
                onTogglePlay = onTogglePlay,
                onFullscreen = onFullscreen,
            )
        }
    }
}

@Composable
private fun LandscapeControls(
    state: PlayerControlsState,
    onBack: () -> Unit,
    onTogglePlay: () -> Unit,
    onSeekBack15: () -> Unit,
    onSeekForward15: () -> Unit,
    onSeek: (Long) -> Unit,
    onToggleCc: () -> Unit,
    onAuto: () -> Unit,
    onExitFullscreen: () -> Unit,
    onToggleLock: () -> Unit,
) {
    if (state.locked) {
        return
    }
    Box(Modifier.fillMaxSize()) {
        Box(
            Modifier
                .fillMaxSize()
                .background(
                    Brush.verticalGradient(
                        listOf(Color(0x88000000), Color.Transparent, Color(0xAA000000)),
                    ),
                ),
        )

        // Top: back + title (ellipsis) | CC — CC must stay on-screen (§7.2 B)
        Row(
            Modifier
                .fillMaxWidth()
                .align(Alignment.TopCenter)
                .padding(horizontal = 4.dp, vertical = 4.dp),
            verticalAlignment = Alignment.CenterVertically,
        ) {
            CompactIconButton(onClick = onBack, contentDescription = "Back") {
                Icon(
                    Icons.AutoMirrored.Filled.ArrowBack,
                    contentDescription = "Back",
                    tint = Color.White,
                    modifier = Modifier.size(20.dp),
                )
            }
            Text(
                text = state.title,
                color = Color.White,
                fontSize = 15.sp,
                fontWeight = FontWeight.Medium,
                maxLines = 1,
                overflow = TextOverflow.Ellipsis,
                modifier = Modifier
                    .weight(1f)
                    .padding(horizontal = 4.dp),
            )
            CcButton(subtitleOn = state.subtitleOn, onClick = onToggleCc)
        }

        CompactIconButton(
            onClick = onToggleLock,
            contentDescription = "Lock",
            modifier = Modifier
                .align(Alignment.CenterEnd)
                .padding(end = 6.dp),
        ) {
            Icon(
                Icons.Default.LockOpen,
                contentDescription = "Lock",
                tint = Color.White,
                modifier = Modifier.size(18.dp),
            )
        }

        Row(
            Modifier.align(Alignment.Center),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.spacedBy(18.dp), // design §B: 16–20dp
        ) {
            Seek15Button(forward = false, onClick = onSeekBack15)
            PrimaryPlayPause(isPlaying = state.isPlaying, onClick = onTogglePlay)
            Seek15Button(forward = true, onClick = onSeekForward15)
        }

        // 08-style: progress row (times at ends) + next row MiniPause | AUTO+exit
        Column(
            Modifier
                .fillMaxWidth()
                .align(Alignment.BottomCenter)
                .padding(horizontal = 12.dp, vertical = 8.dp),
        ) {
            LandscapeProgressBlock(
                state = state,
                onSeek = onSeek,
                onTogglePlay = onTogglePlay,
                onAuto = onAuto,
                onExitFullscreen = onExitFullscreen,
            )
        }
    }
}

@Composable
private fun PrimaryPlayPause(isPlaying: Boolean, onClick: () -> Unit) {
    // V6 §7.1: red primary 52dp (only red control)
    Box(
        modifier = Modifier
            .size(52.dp)
            .clip(CircleShape)
            .background(NetflixRed)
            .clickable(onClick = onClick),
        contentAlignment = Alignment.Center,
    ) {
        Icon(
            imageVector = if (isPlaying) Icons.Default.Pause else Icons.Default.PlayArrow,
            contentDescription = if (isPlaying) "Pause" else "Play",
            tint = Color.White,
            modifier = Modifier.size(28.dp),
        )
    }
}

@Composable
private fun Seek15Button(forward: Boolean, onClick: () -> Unit) {
    // Design §B: Column(环 28dp + 「15s」10sp SemiBold 白); touch ≤40dp
    Column(
        modifier = Modifier
            .width(40.dp)
            .height(40.dp)
            .clickable(
                indication = null,
                interactionSource = remember { MutableInteractionSource() },
                onClick = onClick,
            ),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center,
    ) {
        Icon(
            painter = painterResource(
                if (forward) R.drawable.ic_seek_forward_15 else R.drawable.ic_seek_back_15,
            ),
            contentDescription = if (forward) "+15s" else "-15s",
            tint = Color.White,
            modifier = Modifier.size(28.dp),
        )
        Text(
            text = "15s",
            color = Color.White,
            fontSize = 10.sp,
            fontWeight = FontWeight.SemiBold,
            lineHeight = 10.sp,
            maxLines = 1,
        )
    }
}

