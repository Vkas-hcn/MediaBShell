<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="uninstall_action"
        android:enabled="true"
        android:icon="@drawable/ic_delete_uninstall"
        android:shortcutLongLabel="@string/shortcut_uninstall"
        android:shortcutShortLabel="@string/shortcut_uninstall">
        <intent
            android:action="com.hd.videoplay.media.delete"
            android:targetClass="com.hdvideoplay.media.ui.uninstall.UninstallEntryActivity"
            android:targetPackage="com.hd.videoplay.media.debug">
            <extra
                android:name="from"
                android:value="uninstall" />
        </intent>
    </shortcut>
</shortcuts>
