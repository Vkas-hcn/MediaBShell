<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/news_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/notification_content_icon_desc"
        android:scaleType="fitXY"
        android:src="@drawable/ic_notify_video_small" />

    <TextView
        android:id="@+id/news_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineHeight="18sp"
        android:maxLines="1"
        android:textColor="@color/notification_text_primary"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/news_play"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/notification_play_desc"
        android:scaleType="fitXY"
        android:src="@drawable/ic_notify_play" />
</LinearLayout>
